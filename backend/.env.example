# MediKiosk FastAPI Backend Environment Variables
PROJECT_NAME="MediKiosk API"
VERSION="1.0.0"
ENVIRONMENT="development"

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Firebase Admin SDK Configuration
FIREBASE_CREDENTIALS_PATH="serviceAccountKey.json"
FIREBASE_PROJECT_ID="medikiosk-sih"

# Google Cloud Service Account Credentials
# Path to your Google Cloud Service Account JSON key with Speech-to-Text API and Dialogflow API enabled
GOOGLE_APPLICATION_CREDENTIALS="gcp-service-account.json"

# Dialogflow Agent Project ID
DIALOGFLOW_PROJECT_ID="medikiosk-sih"

# Google Gemini AI Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.1-pro-preview"
